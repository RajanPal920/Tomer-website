# =========================================================================
# TOMAR ENTERPRISES — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values for your environment.
# Never commit .env with real credentials to source control.
# =========================================================================

# -------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# -------------------------------------------------------------------------
NODE_ENV=development
PORT=5173

# -------------------------------------------------------------------------
# 2. PERSISTENT DATABASE CONFIGURATION
# -------------------------------------------------------------------------
# LOCAL DEVELOPMENT (Default):
# Leave DATABASE_URL empty to use the automatic persistent SQLite database
# stored on disk at server/data/tomar.db
# SQLITE_DB_PATH=./server/data/tomar.db

# PRODUCTION DEPLOYMENT (PostgreSQL):
# Set DATABASE_URL to your managed PostgreSQL instance
# (e.g., Supabase, Neon, AWS RDS, Render PostgreSQL, Railway)
# DATABASE_URL=postgresql://username:password@hostname:5432/tomar_db?sslmode=require

# -------------------------------------------------------------------------
# 3. OWNER / ADMINISTRATOR BOOTSTRAP CREDENTIALS (OPTIONAL)
# -------------------------------------------------------------------------
# Used only if the owner_users table is completely empty on initial boot.
# Alternatively, initialize interactively in terminal via: npm run setup-owner
TOMAR_OWNER_USER=admin
TOMAR_OWNER_PASS=sanjay@82

# -------------------------------------------------------------------------
# 4. OPTIONAL: ADVISORY NOTIFICATIONS & EMAIL SERVICE
# -------------------------------------------------------------------------
# Required only if forwarding customer property enquiries via external SMTP/Resend
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=advisory@tomarenterprises.com
# SMTP_PASS=your-smtp-app-password
